---
import { site, nav } from '../config';
const { active } = Astro.props as { active?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="sticky top-0 z-30 border-b border-ink-100 bg-bar">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
    <a href={base + '/'} class="text-lg font-bold text-primary-700 no-underline">
      {site.name}
    </a>
    <button id="nav-toggle" class="md:hidden rounded p-2 text-primary-800" aria-label="Toggle menu">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line
          x1="3"
          y1="18"
          x2="21"
          y2="18"></line>
      </svg>
    </button>
    <ul
      id="nav-menu"
      class="hidden md:flex flex-col md:flex-row md:items-center gap-1 md:gap-2
      absolute md:static left-0 right-0 top-full md:top-auto border-b md:border-0 border-ink-100
      bg-bar md:bg-transparent px-4 md:px-0 py-2 md:py-0"
    >
      {
        nav.map((item) => (
          <li>
            <a
              href={base + item.href}
              class:list={[
                'block rounded px-3 py-1.5 text-sm font-bold no-underline transition-colors',
                active === item.id
                  ? 'bg-accent-50 text-accent-600'
                  : 'text-ink-700 hover:text-accent-600 hover:bg-black/5',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
