---
// Grid of talk cards: thumbnail, title, location (optional link),
// and optional Slides / Video links.
//
// Thumbnail source, in order of preference:
//   1. an explicit `thumbnail` filename in public/talks/
//   2. auto-generated from the first page of a local pdf `slides` file
//      (see scripts/gen-thumbnails.mjs, run by the prebuild/predev hooks)
//   3. the YouTube video's thumbnail, derived from the `video` url
//   4. the Vimeo video's thumbnail (pre-fetched into public/talks/thumbs/)
//   5. none — the card renders without an image area
const { items } = Astro.props as { items: any[] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Resolve an internal ('/...') path against the site base; leave full URLs as-is.
const resolve = (href: string) => (href?.startsWith('/') ? base + href : href);
const isLocalPdf = (s: string) =>
  typeof s === 'string' && !s.includes('://') && s.toLowerCase().endsWith('.pdf');
const youtubeId = (url: string) => {
  if (typeof url !== 'string') return null;
  const m = url.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/|v\/|shorts\/)|youtu\.be\/)([\w-]{11})/,
  );
  return m ? m[1] : null;
};
const vimeoId = (url: string) => {
  const m = typeof url === 'string' && url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  return m ? m[1] : null;
};
const thumbSrc = (t: any) => {
  if (t.thumbnail) return `${base}/talks/${t.thumbnail}`;
  if (isLocalPdf(t.slides)) {
    const name = t.slides
      .split('/')
      .pop()
      .replace(/\.pdf$/i, '');
    return `${base}/talks/thumbs/${name}.jpg`;
  }
  const yt = youtubeId(t.video);
  if (yt) return `https://img.youtube.com/vi/${yt}/hqdefault.jpg`;
  const vm = vimeoId(t.video);
  if (vm) return `${base}/talks/thumbs/vimeo-${vm}.jpg`;
  return null;
};
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    items.map((t) => {
      const thumb = thumbSrc(t);
      return (
        <div class="flex items-start gap-4 rounded-lg border border-ink-100 bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
          <div class="min-w-0 flex-1">
            {(t.label || t.date) && (
              <p class="mb-1 flex flex-wrap items-center gap-1.5 text-xs font-semibold uppercase tracking-wide">
                {t.label && <span class="text-accent-600">{t.label}</span>}
                {t.label && t.date && <span class="text-ink-300">—</span>}
                {t.date && <span class="text-ink-500">{t.date}</span>}
              </p>
            )}
            <h3 class="font-medium text-ink-900">{t.title}</h3>
            {t.location && (
              <p class="mt-1 text-sm text-ink-500">
                {t.locationUrl ? <a href={resolve(t.locationUrl)}>{t.location}</a> : t.location}
              </p>
            )}
            {(t.slides || t.video) && (
              <p class="mt-2 flex flex-wrap gap-3 text-sm">
                {t.slides && <a href={resolve(t.slides)}>Slides</a>}
                {t.video && <a href={resolve(t.video)}>Video</a>}
              </p>
            )}
          </div>
          {thumb && (
            <img
              src={thumb}
              alt={t.title}
              class="aspect-video w-40 shrink-0 rounded object-cover"
            />
          )}
        </div>
      );
    })
  }
</div>
